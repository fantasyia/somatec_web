# =============================================================================
# MSM Site - Variáveis de ambiente
# Copie este arquivo para .env.local e preencha conforme necessário
# =============================================================================

# ----- Site (público) -----
NEXT_PUBLIC_SITE_URL=https://msm.com.br

# Onde a rota /login redireciona o representante (app externo).
# Se vazio, exibe fallback "portal disponibilizado em breve".
NEXT_PUBLIC_REPRESENTATIVE_APP_URL=

# ----- Supabase (v1.0) -----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NUNCA exposta no frontend. Apenas em server actions / API routes.
SUPABASE_SERVICE_ROLE_KEY=
# Conexão direta (porta 5432) — usada por scripts/apply-migrations.mjs (schema base em supabase/migrations/)
# Formato: postgresql://postgres:<senha>@<host>:5432/postgres
# Encontrar em: Supabase dashboard → Project Settings → Database → Connection string → URI (Direct)
DIRECT_URL=

# Conexão usada por `npm run migrate` / `npm run seed` (scripts/apply-seed.mjs → aplica scripts/*.sql).
# Normalmente o MESMO valor de DIRECT_URL. Necessária p/ aplicar seeds/ajustes (ex: 014-certifications).
DATABASE_URL=

# ----- MullerBot / Webhook CRM (v1.0) -----
# Pode ficar vazio no início; admin exibe "integração não configurada".
MULLERBOT_WEBHOOK_URL=
MULLERBOT_API_KEY=

# ----- Anti-spam: Cloudflare Turnstile (v1.1) -----
# Site key de teste em desenvolvimento: 1x00000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ----- Rate limiting: Upstash Redis (v1.1) -----
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ----- Cache / ISR (v1.1) -----
# Gerar uma string aleatória forte (ex: openssl rand -hex 32)
REVALIDATE_SECRET=

# ----- Cron job auth (v1.1) -----
# Protege /api/cron/process-webhook-queue contra chamadas externas.
# No Railway: criar um serviço Cron no dashboard com o comando:
#   curl -s -f -H "Authorization: Bearer $CRON_SECRET" https://<dominio>/api/cron/process-webhook-queue
# Schedule sugerido: */5 * * * *
# Gerar com: openssl rand -hex 32
CRON_SECRET=

# ----- Frete: Melhor Envio (checkout NI) -----
# Onde pegar: https://melhorenvio.com.br → Configurações → Tokens (ou app OAuth).
# Sem estas variáveis o site NÃO quebra: /api/frete responde sem cotação e o
# checkout usa o prazo genérico (a promoção de frete grátis já zera o valor).
# Escopo mínimo do token: shipping-calculate
MELHOR_ENVIO_TOKEN=
# CEP de onde a mercadoria sai (só dígitos)
MELHOR_ENVIO_CEP_ORIGEM=
# A API exige User-Agent identificável com e-mail de contato técnico
MELHOR_ENVIO_UA=Somatec Blocking (comercial@somatecblocking.com.br)
# true = usa sandbox.melhorenvio.com.br (homologação)
MELHOR_ENVIO_SANDBOX=false

# ----- Pagamento: Asaas (checkout do site) -----
# Sandbox:   https://api-sandbox.asaas.com/v3   (chave $aact_hmlg_…)
# Produção:  https://api.asaas.com/v3           (chave $aact_prod_…)
# A chave de sandbox NÃO funciona em produção: virar de ambiente é trocar as duas.
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=
# Segredo que NÓS inventamos e cadastramos no painel do Asaas (Integrações →
# Webhooks). Ele volta no cabeçalho `asaas-access-token` de cada evento e é o que
# prova que a chamada é do Asaas — a URL do webhook é pública. Sem ele, a rota
# recusa tudo. Gerar com: openssl rand -hex 32
ASAAS_WEBHOOK_TOKEN=
# Pra onde vai o aviso de "pagamento confirmado". Vazio = comercial@ (o canal
# de sempre). Em TESTE, aponte pra outra caixa: aviso de pagamento que não
# corresponde a dinheiro nenhum treina quem opera a ignorar o aviso.
PAGAMENTO_ALERTA_EMAIL=
# Liga o pagamento online na TELA. Só virar true onde a chave acima existir —
# senão o checkout promete pagamento que não acontece.
NEXT_PUBLIC_GATEWAY_ATIVO=false

# ----- GA4 server-side: o `purchase` da confirmação de pagamento -----
# O site dispara `pedido_registrado` no navegador e o valor CHEGA no GA4 — mas
# `purchaseRevenue` fica em zero e o público "Purchasers" nunca enche, porque só
# evento de NOME PADRÃO alimenta relatório de e-commerce. O `purchase` de
# verdade sai do servidor, quando o Asaas confirma que o dinheiro entrou.
#
# Sem as duas variáveis nada é enviado e nada quebra (igual ao CAPI da Meta).
#
# GA4_MEASUREMENT_ID: o G-XXXXXXXXXX do fluxo do site.
# GA4_API_SECRET: painel do GA4 → Admin → Fluxos de dados → o fluxo →
#   "Measurement Protocol API secrets" → Criar. É segredo: só no Railway.
GA4_MEASUREMENT_ID=
GA4_API_SECRET=
# ⚠️ O Measurement Protocol responde 204 tanto pra evento aceito quanto pra
# evento recusado — falha CALADO. Com true, a chamada vai pro endpoint de
# validação do Google e o motivo da recusa aparece no log. Ligar na primeira
# verificação, desligar depois (no modo debug o evento NÃO é gravado).
GA4_MP_DEBUG=false
